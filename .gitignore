*.[wW][aA][vV]
*.[wW][aA][vV][eE]
*.[mM][pP]3
*.[fF][lL][aA][cC]
*.[aA][iI][fF]
*.[aA][iI][fF][fF]
*.[mM]4[aA]
*.[aA][aA][cC]
*.[oO][gG][gG]
*.[oO][pP][uU][sS]
*.[wW][mM][aA]
*.[mM][pP]4
*.[wW][eE][bB][mM]
*.[pP][tT]
*.[pP][tT][hH]
